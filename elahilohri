<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Elahi's Lohri Invitation</title>
  <style>
    :root { color-scheme: dark; }
    body {
      margin: 0;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background: #0b0b0b;
      color: #fff;
      display: grid;
      place-items: center;
      min-height: 100vh;
      padding: 16px;
      gap: 12px;
    }
    .wrap {
      width: min(420px, 95vw);
      display: grid;
      gap: 10px;
    }
    .card {
      background: #121212;
      border: 1px solid rgba(255,255,255,.08);
      border-radius: 14px;
      padding: 12px;
      box-shadow: 0 10px 30px rgba(0,0,0,.35);
    }
    .row { display: grid; gap: 10px; }
    label { font-size: 13px; opacity: .9; }
    input[type="file"] { width: 100%; }
    button {
      width: 100%;
      border: 0;
      border-radius: 12px;
      padding: 12px 14px;
      font-weight: 700;
      cursor: pointer;
      background: #f6c65b;
      color: #1b1305;
    }
    button.secondary {
      background: #2a2a2a;
      color: #fff;
      border: 1px solid rgba(255,255,255,.12);
    }
    button:disabled { opacity: .55; cursor: not-allowed; }
    .hint { font-size: 12px; opacity: .75; line-height: 1.35; }
    canvas {
      width: min(360px, 90vw);
      aspect-ratio: 9 / 16;
      border-radius: 14px;
      border: 1px solid rgba(255,255,255,.10);
      background: #000;
    }
    .two {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    @media (max-width: 420px) { .two { grid-template-columns: 1fr; } }
  </style>
</head>
<body>
  <div class="wrap">
    <canvas id="c" width="1080" height="1920"></canvas>

    <div class="card row">
      <div class="two">
        <div class="row">
          <label>Background 1 (bonfire)</label>
          <input id="bg1" type="file" accept="image/*" />
        </div>
        <div class="row">
          <label>Background 2 (venue)</label>
          <input id="bg2" type="file" accept="image/*" />
        </div>
      </div>

      <div class="two">
        <div class="row">
          <label>Background 3 (date)</label>
          <input id="bg3" type="file" accept="image/*" />
        </div>
        <div class="row">
          <label>Background 4 (gold frame)</label>
          <input id="bg4" type="file" accept="image/*" />
        </div>
      </div>

      <div class="row">
        <label>Elahi photo (optional — will be placed inside frame)</label>
        <input id="photo" type="file" accept="image/*" />
      </div>

      <div class="two">
        <button id="previewBtn" class="secondary">Preview</button>
        <button id="recordBtn" disabled>Record & Download Video</button>
      </div>

      <div class="hint">
        • Video downloads as <b>.webm</b> (best quality). You can send on WhatsApp or convert to MP4 using any converter/VLC later.<br>
        • On some phones, recording works best in <b>Chrome</b>.
      </div>
    </div>
  </div>

<script>
(() => {
  const W = 1080, H = 1920, FPS = 30;

  // Timing (seconds)
  const SLIDE_SECONDS = 4.5;      // time each slide stays
  const FADE_SECONDS  = 1.0;      // crossfade duration
  const TOTAL_SLIDES = 4;

  // Text content
  const DETAILS = {
    title: "Elahi's Lohri",
    dateLine: "28 January 2026",
    timeLine: "10:00 AM",
    venueLine: "Thousand Spices",
  };

  const canvas = document.getElementById('c');
  const ctx = canvas.getContext('2d');

  const inp = {
    bg1: document.getElementById('bg1'),
    bg2: document.getElementById('bg2'),
    bg3: document.getElementById('bg3'),
    bg4: document.getElementById('bg4'),
    photo: document.getElementById('photo'),
  };

  const previewBtn = document.getElementById('previewBtn');
  const recordBtn  = document.getElementById('recordBtn');

  const imgs = { bg1:null, bg2:null, bg3:null, bg4:null, photo:null };

  function loadImageFromFile(file) {
    return new Promise((resolve, reject) => {
      if (!file) return resolve(null);
      const url = URL.createObjectURL(file);
      const im = new Image();
      im.onload = () => resolve(im);
      im.onerror = reject;
      im.src = url;
    });
  }

  async function loadAll() {
    imgs.bg1 = await loadImageFromFile(inp.bg1.files[0]);
    imgs.bg2 = await loadImageFromFile(inp.bg2.files[0]);
    imgs.bg3 = await loadImageFromFile(inp.bg3.files[0]);
    imgs.bg4 = await loadImageFromFile(inp.bg4.files[0]);
    imgs.photo = await loadImageFromFile(inp.photo.files[0]);

    // Enable record only if 4 bgs are loaded
    recordBtn.disabled = !(imgs.bg1 && imgs.bg2 && imgs.bg3 && imgs.bg4);
  }

  // Draw helpers
  function coverDraw(im, alpha=1) {
    if (!im) return;
    ctx.save();
    ctx.globalAlpha = alpha;

    // cover
    const iw = im.width, ih = im.height;
    const scale = Math.max(W/iw, H/ih);
    const sw = iw * scale, sh = ih * scale;
    const dx = (W - sw)/2, dy = (H - sh)/2;
    ctx.drawImage(im, dx, dy, sw, sh);

    ctx.restore();
  }

  function glowOverlay(alpha=1) {
    ctx.save();
    ctx.globalAlpha = alpha;
    const g = ctx.createRadialGradient(W*0.5, H*0.35, 50, W*0.5, H*0.35, H*0.9);
    g.addColorStop(0, "rgba(255,220,140,0.20)");
    g.addColorStop(1, "rgba(0,0,0,0.55)");
    ctx.fillStyle = g;
    ctx.fillRect(0,0,W,H);
    ctx.restore();
  }

  function textBlock({y, lines, size=64, weight=700, align="center"}) {
    ctx.save();
    ctx.textAlign = align;
    ctx.textBaseline = "middle";
    ctx.fillStyle = "rgba(255,245,220,0.98)";
    ctx.shadowColor = "rgba(0,0,0,0.65)";
    ctx.shadowBlur = 18;
    ctx.shadowOffsetY = 6;
    ctx.font = `${weight} ${size}px Georgia, "Times New Roman", serif`;

    const x = align === "center" ? W*0.5 : (align === "left" ? W*0.10 : W*0.90);
    const lineH = size * 1.2;
    const startY = y - ((lines.length - 1) * lineH)/2;
    lines.forEach((t, i) => ctx.fillText(t, x, startY + i*lineH));

    ctx.restore();
  }

  function pill({y, icon, label}) {
    ctx.save();
    const padX=34, padY=18;
    ctx.font = `600 44px system-ui, -apple-system, Segoe UI, Roboto, Arial`;
    const textW = ctx.measureText(label).width;
    const w = textW + padX*2 + 70;
    const h = 88;
    const x = (W - w)/2;

    ctx.globalAlpha = 0.92;
    ctx.fillStyle = "rgba(0,0,0,0.45)";
    roundRect(x, y - h/2, w, h, 26);
    ctx.fill();

    ctx.globalAlpha = 1;
    ctx.fillStyle = "rgba(255,240,210,0.98)";
    ctx.textAlign="left"; ctx.textBaseline="middle";
    ctx.fillText(icon, x + 26, y);
    ctx.fillText(label, x + 26 + 54, y);

    ctx.restore();
  }

  function roundRect(x,y,w,h,r){
    ctx.beginPath();
    ctx.moveTo(x+r, y);
    ctx.arcTo(x+w, y, x+w, y+h, r);
    ctx.arcTo(x+w, y+h, x, y+h, r);
    ctx.arcTo(x, y+h, x, y, r);
    ctx.arcTo(x, y, x+w, y, r);
    ctx.closePath();
  }

  // Photo inside frame (slide 4)
  function drawPhotoInFrame() {
    if (!imgs.photo) return;

    // These values fit the gold frame image we generated (approx).
    // If your frame differs, adjust these 4 numbers a little.
    const frameInner = {
      x: 190, y: 260,
      w: 700, h: 1180
    };

    ctx.save();
    // draw photo cover inside inner frame rect
    const im = imgs.photo;
    const scale = Math.max(frameInner.w/im.width, frameInner.h/im.height);
    const sw = im.width * scale, sh = im.height * scale;
    const dx = frameInner.x + (frameInner.w - sw)/2;
    const dy = frameInner.y + (frameInner.h - sh)/2;

    // clip to inner rectangle
    roundRect(frameInner.x, frameInner.y, frameInner.w, frameInner.h, 30);
    ctx.clip();
    ctx.drawImage(im, dx, dy, sw, sh);
    ctx.restore();
  }

  // Slides (draw background + overlay text)
  function drawSlide(idx) {
    ctx.clearRect(0,0,W,H);

    if (idx === 0) {
      coverDraw(imgs.bg1, 1);
      glowOverlay(1);
      textBlock({ y: H*0.26, size: 92, lines: ["Lohri Celebration"]});
      textBlock({ y: H*0.40, size: 110, lines: [DETAILS.title]});
      textBlock({ y: H*0.53, size: 46, weight: 500, lines: ["Warmth • Tradition • Joy"]});
    }

    if (idx === 1) {
      coverDraw(imgs.bg2, 1);
      glowOverlay(1);
      textBlock({ y: H*0.28, size: 96, lines: ["Venue"]});
      textBlock({ y: H*0.40, size: 84, lines: [DETAILS.venueLine]});
      textBlock({ y: H*0.55, size: 46, weight: 500, lines: ["A cozy morning celebration with family & friends"]});
    }

    if (idx === 2) {
      coverDraw(imgs.bg3, 1);
      glowOverlay(1);
      textBlock({ y: H*0.24, size: 90, lines: ["Date & Time"]});
      pill({ y: H*0.42, icon: "📅", label: DETAILS.dateLine });
      pill({ y: H*0.53, icon: "⏰", label: DETAILS.timeLine });
      pill({ y: H*0.64, icon: "📍", label: DETAILS.venueLine });
    }

    if (idx === 3) {
      coverDraw(imgs.bg4, 1);
      glowOverlay(0.7);
      drawPhotoInFrame();
      textBlock({ y: H*0.16, size: 84, lines: [DETAILS.title]});
      textBlock({ y: H*0.84, size: 46, weight: 500, lines: ["See you there!"]});
    }
  }

  // Animation timeline
  let raf = null;
  function animateOnce({onFrame, onDone}) {
    const slideTotal = SLIDE_SECONDS + FADE_SECONDS; // per slide time including fade into next
    const totalSeconds = (TOTAL_SLIDES * SLIDE_SECONDS) + ((TOTAL_SLIDES - 1) * FADE_SECONDS);
    const start = performance.now();

    function frame(now) {
      const t = (now - start) / 1000; // seconds
      if (t >= totalSeconds) {
        onFrame(totalSeconds, true);
        if (onDone) onDone();
        return;
      }
      onFrame(t, false);
      raf = requestAnimationFrame(frame);
    }

    raf = requestAnimationFrame(frame);
  }

  function renderAtTime(t) {
    // Determine which slide we are on + crossfade
    const per = SLIDE_SECONDS;
    const fade = FADE_SECONDS;

    // Build segment boundaries:
    // Slide0 [0..per], fade0 [per..per+fade], Slide1 [per+fade..2per+fade], fade1...
    let cursor = 0;
    for (let i=0; i<TOTAL_SLIDES; i++) {
      const slideStart = cursor;
      const slideEnd = slideStart + per;

      if (t >= slideStart && t < slideEnd) {
        drawSlide(i);
        return;
      }
      cursor = slideEnd;

      if (i < TOTAL_SLIDES - 1) {
        const fadeEnd = cursor + fade;
        if (t >= cursor && t < fadeEnd) {
          // crossfade i -> i+1
          const a = (t - cursor) / fade; // 0..1
          // draw current and next with alpha
          ctx.clearRect(0,0,W,H);
          drawSlide(i);
          ctx.save();
          ctx.globalAlpha = a;
          drawSlide(i+1);
          ctx.restore();
          return;
        }
        cursor = fadeEnd;
      }
    }
    drawSlide(TOTAL_SLIDES-1);
  }

  // Preview
  previewBtn.addEventListener('click', async () => {
    await loadAll();
    if (!imgs.bg1 || !imgs.bg2 || !imgs.bg3 || !imgs.bg4) {
      alert("Please upload all 4 background images first.");
      return;
    }
    if (raf) cancelAnimationFrame(raf);
    animateOnce({
      onFrame: (t) => renderAtTime(t),
      onDone: () => {}
    });
  });

  // Record
  recordBtn.addEventListener('click', async () => {
    await loadAll();
    if (!imgs.bg1 || !imgs.bg2 || !imgs.bg3 || !imgs.bg4) {
      alert("Please upload all 4 background images first.");
      return;
    }

    // Capture stream
    const stream = canvas.captureStream(FPS);
    let mime = "video/webm;codecs=vp9";
    if (!MediaRecorder.isTypeSupported(mime)) mime = "video/webm;codecs=vp8";
    if (!MediaRecorder.isTypeSupported(mime)) mime = "video/webm";

    const rec = new MediaRecorder(stream, { mimeType: mime, videoBitsPerSecond: 6_000_000 });
    const chunks = [];

    rec.ondataavailable = e => { if (e.data && e.data.size) chunks.push(e.data); };

    const done = new Promise((resolve) => {
      rec.onstop = () => resolve();
    });

    rec.start(250);

    // Render frames for entire timeline
    const totalSeconds = (TOTAL_SLIDES * SLIDE_SECONDS) + ((TOTAL_SLIDES - 1) * FADE_SECONDS);
    const start = performance.now();

    function tick(now) {
      const t = (now - start) / 1000;
      renderAtTime(Math.min(t, totalSeconds));
      if (t < totalSeconds) {
        requestAnimationFrame(tick);
      } else {
        rec.stop();
      }
    }
    requestAnimationFrame(tick);

    await done;

    // Download
    const blob = new Blob(chunks, { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = "Elahi-Lohri-Invitation.webm";
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 2000);
  });

  // Initial placeholder
  ctx.fillStyle = "#000";
  ctx.fillRect(0,0,W,H);
  ctx.fillStyle = "rgba(255,255,255,.85)";
  ctx.font = "600 44px system-ui, -apple-system, Segoe UI, Roboto, Arial";
  ctx.textAlign = "center";
  ctx.fillText("Upload 4 backgrounds + (optional) Elahi photo", W/2, H/2 - 30);
  ctx.fillStyle = "rgba(255,255,255,.65)";
  ctx.font = "400 34px system-ui, -apple-system, Segoe UI, Roboto, Arial";
  ctx.fillText("Then press Preview or Record", W/2, H/2 + 30);

})();
</script>
</body>
</html>
